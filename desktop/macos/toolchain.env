# Canonical macOS Desktop build toolchain.
#
# This machine does not currently have a full Xcode installation. The pinned
# Command Line Tools + macOS 15.4 SDK combination is the exact toolchain that
# produced the verified Desktop candidate on 2026-08-27. When full Xcode is
# installed, update this file once instead of relying on ambient xcode-select.
SOLOSCALE_TOOLCHAIN_KIND="command-line-tools"
SOLOSCALE_DEVELOPER_DIR="/Library/Developer/CommandLineTools"
SOLOSCALE_SDKROOT="/Library/Developer/CommandLineTools/SDKs/MacOSX15.4.sdk"
SOLOSCALE_EXPECTED_SWIFT_VERSION="6.3.2"
SOLOSCALE_EXPECTED_MACOS_SDK_VERSION="15.4"
