BUILDLOG_MODEL=ollama_chat/qwen3
BUILDLOG_MODEL_DIGEST=
BUILDLOG_API_BASE=http://127.0.0.1:11434
BUILDLOG_TEMPERATURE=0.4
BUILDLOG_MAX_TOKENS=2200
BUILDLOG_PROMPT_VERSION=v1
BUILDLOG_CAPTURE_FAILED_STRUCTURED_OUTPUT=false
BUILDLOG_EVAL_THRESHOLD_ACCURACY=8
BUILDLOG_EVAL_THRESHOLD_SPECIFICITY=7
BUILDLOG_EVAL_THRESHOLD_READABILITY=7
BUILDLOG_EVAL_THRESHOLD_VALUE=7
BUILDLOG_EVAL_THRESHOLD_EVIDENCE=7
BUILDLOG_DATABASE_URL=sqlite:///buildlog.db

# Hosted internal application. Production mode requires a strong API key.
BUILDLOG_ENV=development
BUILDLOG_WEB_API_KEY=
BUILDLOG_WEB_WORKER_ENABLED=true
BUILDLOG_WEB_WORKER_POLL_SECONDS=1.0
BUILDLOG_WEB_JOB_STALE_SECONDS=900
BUILDLOG_WEB_JOB_MAX_ATTEMPTS=2
BUILDLOG_WEB_RATE_LIMIT_PER_MINUTE=120
BUILDLOG_TRUST_AZURE_AUTH=false
BUILDLOG_WEB_JOBS_DIR=.buildlog/jobs
BUILDLOG_RUNS_DIR=runs
BUILDLOG_PROMPTS_DIR=prompts
BUILDLOG_SCHEMA_MANAGEMENT=create_all
BUILDLOG_OBJECT_STORE_BACKEND=none
BUILDLOG_AZURE_STORAGE_ACCOUNT_URL=
BUILDLOG_AZURE_STORAGE_CONNECTION_STRING=
BUILDLOG_AZURE_STORAGE_CONTAINER=buildlog-artifacts

# LinkedIn Publishing Baseline. Never commit real values.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8765/auth/linkedin/callback
LINKEDIN_API_VERSION=202607

# X Publishing Baseline. Configure an OAuth 2.0 public client; no secret needed.
X_CLIENT_ID=
X_REDIRECT_URI=http://127.0.0.1:8766/auth/x/callback
